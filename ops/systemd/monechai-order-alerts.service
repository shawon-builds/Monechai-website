[Unit]
Description=Process one Monechai owner order alert
After=network-online.target
OnFailure=monechai-ops-alert@%n.service
[Service]
Type=oneshot
User=monechai
WorkingDirectory=/opt/monechai
EnvironmentFile=/etc/monechai/ops.env
ExecStart=/usr/bin/node /opt/monechai/scripts/order-alert-worker.mjs
TimeoutStartSec=40
