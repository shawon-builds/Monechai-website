# Server-only application connection using the restricted runtime role.
DATABASE_URL=postgresql://monechai_runtime:replace-me@localhost:5432/monechai
# Operator-only connection for migrations and required migration-history preflight.
# Inject separately into operator jobs; never include in app runtime/build environment.
# History checks need only CONNECT, drizzle USAGE and SELECT on drizzle.__drizzle_migrations.
# DIRECT_URL=postgresql://postgres:replace-me@localhost:5432/monechai
# Set to disable only for a local PostgreSQL instance without TLS.
DATABASE_SSL=require
# Optional provider CA PEM (quoted with \n escapes). When supplied, app/preflight
# verify the server certificate and hostname. Obtain CA from Database settings.
# DATABASE_SSL_CA="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"
# Public canonical origin. HTTPS alone never approves indexing.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Server-only owner approval: exact clean HTTPS origin matching NEXT_PUBLIC_SITE_URL.
# Set only in approved production runtime (NODE_ENV=production; VERCEL_ENV if present production).
# Leave unset on staging/preview/test; absent/malformed/mismatch always denies indexing.
# SITE_INDEXING_APPROVED_ORIGIN=https://shop.example.com
# Optional public Supabase project origin (not a key), for published images in the public `products` bucket.
# NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# Public publishable key (not a service-role/secret key); required for admin sign-in.
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
# Owner-verified WhatsApp and support contacts are managed in the admin settings table.
# Set true only behind a reverse proxy that overwrites X-Real-IP and blocks direct Node access.
# CHECKOUT_TRUST_PROXY_IP_HEADER=true
# Production preflight requires this after ingress acceptance; invalid/missing
# x-real-ip denies checkout/preview and account rate limits without cookie fallback.

# Optional owner alerts: set private server-only SMTP values after provider setup.
# SMTP_HOST / SMTP_PORT (465 or 587) / SMTP_USER / SMTP_PASSWORD
# EMAIL_FROM / ORDER_ALERT_EMAIL / OPS_ALERT_EMAIL
# ORDER_WORKER_SECRET: generated random secret >=32 characters; shared with private scheduler.
# Auth SMTP lives in Supabase dashboard, with six-digit recovery email template.
# Backup operator environment is separate from browser/app build variables:
# BACKUP_DATABASE_URL / BACKUP_SUPABASE_URL / BACKUP_OUTPUT_DIR
# BACKUP_ENCRYPTION_PASSWORD / BACKUP_PG_IMAGE
# HEALTHCHECK_URL: canonical /api/health URL for health script.
# See docs/PROJECT_RECORD.md#owner-setup-checklist and docs/OPERATIONS_CHECKS.md.
